{
  "mcpServers": {
    "tigris": {
      "command": "npx",
      "args": ["-y", "@tigrisdata/tigris-mcp-server", "run"],
      "env": {
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "AWS_ENDPOINT_URL_S3": "${AWS_ENDPOINT_URL_S3}"
      }
    }
  }
}
