/* Root follows the same hosting pattern as CarSelectionScreen's
   .car-selection-root / LoginScreen's .login-card being placed inside
   ParentPageController's "center-container" (see ParentPage.uss -
   flex-grow:1, justify-content:center, align-items:center). A card that
   doesn't set flex-grow:1 (main axis) and width:100% (cross axis) on its
   own root only ever gets sized to its content and centered with leftover
   space around it - CarSelectionScreen avoids that by giving its root both.
   Previously this root also carried a translucent/blurred "glass-card" look
   (background blur, border, rounded corners, max-width:700px) that made it
   read as a floating card rather than a full screen - dropped in favor of a
   full-bleed root that fills center-container properly.
   Background is deliberately transparent (explicit user call, overriding
   mobile-designs.tsx's standalone bg-[#0e0e0e]) - this screen renders over
   ParentPage's shared background image, the same convention Login/
   CarSelection already use, rather than covering it with its own solid
   color. If box legibility against that background becomes an issue again,
   fix it by adjusting the individual box opacities below, not by giving
   this root its own background back. */
.estimator-root {
    flex-grow: 1;
    width: 100%;
    background-color: transparent;
    flex-direction: column;
    padding: 6% 5% 0 5%; /* Bottom moved to .gradient-button's own
        margin-bottom (see below) - percentage padding here resolves
        against this root's WIDTH, not height (confirmed live, same trap
        hit twice already on this screen), so it was never a reliable way
        to control vertical space from the screen edge, and CarSelection
        used a different percentage (8% vs this 4%), so the two screens'
        button spacing was never actually consistent despite looking
        similar. Standardized project-wide in .gradient-button/.start-button
        instead, with a fixed px value shared by both. */
}

.header {
    align-items: center;
    margin-bottom: 5%;
}

.title {
    font-size: 20px;
    -unity-text-align: middle-center;
    margin-bottom: 2%;
    color: rgb(192, 192, 192);
    -unity-font-style: bold;
}

.subtitle {
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgba(192, 192, 192, 0.6);
}

/* estimator-scroll no longer needs a percentage max-height hack - that was
   only ever needed because the old .glass-card root had no real resolved
   height for a percentage to resolve against (auto/hug-content). Now that
   .estimator-root fills real space via flex-grow:1 all the way up to
   ParentPage's center-container, flex-grow:1/flex-shrink:1 alone correctly
   bounds the ScrollView within whatever space is left after the header,
   retail-price strip and the Send to Dealer button (now a sibling outside
   the scroll, not the scroll's last child - see EstimatorCard.uxml). */
.estimator-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 3%;
}

.info-box {
    background-color: rgba(0, 212, 255, 0.05);
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.2);
    border-radius: 12px;
    padding: 4%;
    margin-bottom: 5%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.info-label {
    font-size: 12px;
    color: rgba(192, 192, 192, 0.7);
}

.info-value {
    font-size: 18px;
    color: rgb(192, 192, 192);
}

.two-columns {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 4%;
}

.two-columns > .input-group {
    width: 48%;
    margin-bottom: 4%;
}

.input-group {
    flex-direction: column;
}

.field-label {
    font-size: 12px;
    color: rgb(192, 192, 192);
    margin-bottom: 2%;
}

.currency-field,
.term-field {
    background-color: transparent;
    border-width: 0;
}

.input-field {
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
    width: 100%;
}

/* Colors match the neutral input styling other screens already use for
   this kind of secondary control - CarSelectionScreen's .dropdown-button /
   .search-container (rgba(255,255,255,0.05) fill, rgba(192,192,192,0.2)
   border) - and match mobile-designs.tsx's EstimatorScreen input styling
   exactly, so this was a case of the two sources agreeing rather than
   conflicting. */
.input-field .unity-text-field__input {
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(192, 192, 192, 0.2);
    border-radius: 12px;
    padding: 0 4%;
    color: rgb(192, 192, 192);
    font-size: 14px;
    transition-property: border-color;
    transition-duration: 0.2s;
    height: 42px; /* Matches LoginScreen's .input-field height - percentage
                     padding alone (the old rule) resolves against this
                     field's much narrower 48%-width column, producing a
                     visibly thinner field than every other screen's inputs. */
}

.input-field .unity-text-field__input:focus {
    border-color: rgb(0, 212, 255);
    background-color: rgba(255, 255, 255, 0.1);
}

.inline-suffix {
    font-size: 12px;
    color: rgba(192, 192, 192, 0.6);
    margin-left: 4px;
}

.highlight .financed-value {
    font-size: 16px;
    color: rgb(0, 212, 255);
    /* Blue tint/border kept (reverted back from a neutral-gray attempt) -
       the actual alignment bug was never the color, it was the missing
       width:100% below. This box is deliberately visually distinct as
       the one read-only/computed value in the grid. */
    background-color: rgba(0, 212, 255, 0.06);
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.2);
    border-radius: 8px;
    padding: 0 12px;
    width: 100%; /* .input-field sets this on its TextFields to stretch to
                    the full cell width - this Label never had it, so it
                    was hugging its own content width (112.66px) instead
                    of matching its cell (184.71px), leaving it narrower
                    and offset from Trade-In's box directly above it in
                    the same column. This, not the height/color from
                    earlier, was the actual alignment problem. */
    margin: 0; /* Unity's default .unity-label class carries its own
                  margin (confirmed live: marginTop was 4.02px unset) -
                  the sibling TextField-based boxes don't inherit that
                  since they're not Label elements, so without this the
                  two boxes in the same row start at different heights
                  even with identical height/padding set. */
    height: 42px; /* Matches .input-field's height (see above) - without
                     this the box auto-sizes shorter than its row sibling
                     (Loan Term's input), so the two don't line up. */
    -unity-text-align: middle-left; /* Matches the other 3 boxes in this
                                        grid (all MiddleLeft by default on
                                        TextField) - was middle-center,
                                        the one inconsistent box. */
}

.slider-group {
    margin-bottom: 6%;
}

.slider-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2%;
}

.slider-value {
    font-size: 14px;
    color: rgb(0, 212, 255);
}

/* The class names this used before (.unity-slider__track, .unity-dragger)
   don't exist on this Unity version's Slider - its actual internal
   hierarchy (confirmed by querying a live Slider instance) is
   .unity-base-slider__drag-container > [.unity-base-slider__tracker,
   .unity-base-slider__dragger-border, .unity-base-slider__dragger], BEM-
   style, not the older short aliases. None of the rules below were ever
   applying - what showed on-screen was Unity's completely unstyled default
   slider look. */
.custom-slider {
    margin: 2% 0;
}

.custom-slider .unity-base-slider__tracker {
    background-color: rgba(192, 192, 192, 0.15);
    border-radius: 4px;
    border-width: 0;
    height: 6px;
}

/* Value-based color fill up to the current position (matching the design's
   `linear-gradient(to right, COLOR X%, track-color X%)`, which UI Toolkit's
   USS can't express directly since it has no gradient background support -
   done instead as a separate absolutely-positioned VisualElement
   (EstimatorCardController creates it and resizes it on every value change)
   inserted as a sibling right after the tracker, so it paints over the
   tracker but still sits behind the dragger/dragger-border below it. */
.slider-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 4px;
    background-color: rgb(0, 212, 255);
}

.custom-slider--balloon .slider-fill {
    background-color: rgb(255, 215, 0);
}

/* unity-base-slider__dragger-border is Unity's default theme's own decorative
   ring element, but it resolves to a 0x0 box in this project regardless of
   width/border-width set on it here - border-radius alone takes (confirmed:
   50% applied), but a border can't render meaningfully around a zero-sized
   box. Putting the border directly on the dragger circle itself instead,
   which is already reliably sized (18x18, confirmed working). */
.custom-slider .unity-base-slider__dragger {
    background-color: rgb(0, 212, 255);
    border-radius: 50%;
    width: 18px;
    height: 18px;
    margin-top: -9px; /* Unity's built-in theme sets marginTop: -12.07px on
                          this element by default (confirmed live) - that's
                          -halfHeight for whatever this control's default
                          thumb size is, used to center it against the
                          track regardless of a taller drag-container. Our
                          18px override needs its own -halfHeight (-9px) or
                          it centers for the wrong size and sits ~3px above
                          the track instead of on it. */
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    /* text-shadow is the only glow USS supports here (see .payment-value's
       comment above) - it paints on text, not backgrounds, so it doesn't
       apply to this element; this border is this control's stand-in for
       the design's box-shadow glow ring. */
}

.custom-slider .unity-base-slider__dragger:hover {
    background-color: rgba(0, 212, 255, 0.8);
}

.custom-slider--balloon .unity-base-slider__dragger {
    background-color: rgb(255, 215, 0);
}

.custom-slider--balloon .unity-base-slider__dragger:hover {
    background-color: rgba(255, 215, 0, 0.8);
}

.slider-range-labels {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 2%;
}

.range-min,
.range-max {
    font-size: 10px;
    color: rgba(192, 192, 192, 0.5);
}

.balloon-dollar {
    font-size: 11px;
    color: rgba(255, 215, 0, 0.9);
    margin-top: 2%;
    -unity-text-align: middle-center;
}

.payment-box {
    background-color: rgba(0, 212, 255, 0.09);
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.25);
    border-radius: 12px;
    padding: 19px 19px 48px 19px; /* Fixed px, not %, and deliberately
        asymmetric top/bottom - percentage padding resolves against this
        box's WIDTH even for top/bottom (standard box-model behavior,
        already the root cause of two earlier bugs on this same screen),
        making the vertical gap unrelated to the actual font sizes inside.
        payment-value's 32px font carries far more line-height overhang
        below its glyphs than payment-label's 12px font carries above
        (confirmed live: equal 5%/5% padding still left the bottom gap
        visually negative - text overflowing the box - while the top gap
        stayed ~24.5px). 45px bottom vs 19px top is what measured out to
        matching visible gaps above the label and below whatever's
        actually last (payment-value, or balloon-info's text when the
        balloon container is showing - both were checked). */
    margin: 0;
    flex-direction: column;
    align-items: center;
}

.payment-label {
    font-size: 12px;
    color: rgba(192, 192, 192, 0.8);
    margin-bottom: 2%;
    -unity-text-align: middle-center;
}

/* mobile-designs.tsx specifies "font-light" (a lighter weight) for this
   number - Unity's -unity-font-style only offers normal/bold/italic
   combinations (no intermediate weight without a dedicated light font
   asset), so normal is the closest available match; previously this was
   bold, which read heavier than the design intends. text-shadow is used
   for the glow the design applies via box-shadow on the whole payment box
   (unsupported in this UI Toolkit version - see SplashScreen.uss's
   glowing-"X" wordmark for the same workaround already used in this
   project) - applied to the number itself rather than the box, since
   text-shadow only paints on text. */
.payment-value {
    font-size: 32px;
    color: rgb(0, 212, 255);
    -unity-font-style: normal;
    text-shadow: 0 0 12px rgba(0, 212, 255, 0.6);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.balloon-container {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 215, 0, 0.2);
    width: 84%;
    align-items: center;
    /* Percentage margin/padding resolves against the containing block's
       WIDTH even for top/bottom values (standard box-model behavior) - at
       this element's ~289px width, the old 3%/3% came out to a combined
       ~17px for margin+padding+border, not enough room for an 11px label
       to lay out in, so the container's own resolved height collapsed to
       ~11px total (confirmed live: worldBound.height was 11.34, with the
       label's own height inside reporting 0). Fixed px values instead. */
}

.balloon-info {
    font-size: 11px;
    color: rgba(255, 215, 0, 0.9);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* text-shadow glow on the button label approximates the design's
   box-shadow glow around the whole button - same box-shadow-unavailable
   workaround as .payment-value above. */
.gradient-button {
    background-color: rgba(0, 212, 255, 0.8);
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.5);
    border-radius: 12px;
    padding: 12px;
    color: white;
    font-size: 14px;
    -unity-text-align: middle-center;
    text-shadow: 0 0 10px rgba(0, 212, 255, 0.5);
    margin: 0 0 24px 0; /* Standardized project-wide bottom-of-screen
        button spacing - same 24px on CarSelectionScreen's .start-button.
        Fixed px, not %, and on the button itself rather than its root's
        padding-bottom, so it's not tied to either screen's root width and
        can't silently drift out of sync between screens the way the two
        roots' own padding-bottom percentages already had (4% vs 8%,
        neither of which was really about vertical space anyway - see
        .estimator-root's comment above). */
    flex-shrink: 0;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.gradient-button:hover {
    background-color: rgba(0, 150, 200, 0.9);
}

/* Backend submission failure for the Send to Dealer button - same red/
   centered convention as LoginScreen.uss's .form-error. */
.estimator-error {
    font-size: 12px;
    color: rgb(255, 85, 85);
    -unity-text-align: middle-center;
    margin: 0 0 8px 0;
    white-space: normal;
}

.footnote {
    font-size: 10px;
    color: rgba(192, 192, 192, 0.5);
    -unity-text-align: middle-center;
    margin-top: 2%;
    padding-bottom: 2%;
    white-space: pre-wrap;
}

.estimator-scroll .unity-scroll-view__vertical-scroller,
.estimator-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
    visibility: hidden;
}
