/* Global loading overlay — lives on the persistent Game Manager prefab
   (see LoadingOverlayController), not tied to any one scene/screen. Reuses
   SplashScreen's spinner look (same accent blue, same ring style) since
   both are "something async is happening" indicators, just triggered
   differently: splash is dismissed by a button tap, this one is shown/
   hidden entirely by LoadingStartedEvent/LoadingFinishedEvent. */

.loading-overlay-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    /* Solid, not translucent - this overlay is meant to fully hide whatever's
       behind it during a scene transition (see ParentPageController.OnCarSelected),
       same flat bg-[#121212] as the splash screen for visual consistency. */
    background-color: rgb(18, 18, 18);
}

.loading-spinner {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-top-width: 4px;
    border-left-color: rgba(0, 212, 255, 0.3);
    border-right-color: rgba(0, 212, 255, 0.3);
    border-bottom-color: rgba(0, 212, 255, 0.3);
    border-top-color: rgb(0, 212, 255);
}

.loading-message {
    margin-top: 16px;
    font-size: 12px;
    color: rgba(192, 192, 192, 0.8);
    -unity-text-align: middle-center;
}
